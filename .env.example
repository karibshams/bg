# Bhromonghuri Environment Variables
SECRET_KEY=django-insecure-bhromonghuri-travel-secret-key-2026-bangladesh
DEBUG=True
ALLOWED_HOSTS=*

# Database: Defaults to SQLite3 if DATABASE_URL is empty
DATABASE_URL=

# Media Storage (Optional Cloudinary / S3 in production)
CLOUDINARY_URL=

# Admin / Site Details
SITE_NAME=Bhromonghuri
SITE_TAGLINE="Explore • Experience • Discover"

# Google OAuth 2.0 Credentials (SSO)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret
